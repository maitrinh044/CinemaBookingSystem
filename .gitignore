# ==========================================
# Root .gitignore for Cinema Booking Monorepo
# ==========================================

# Operating System & Editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project

# Environment & Secrets
.env
.env.local
.env.*.local
*.secret
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Frontend (React + Vite + TypeScript)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.temp/
frontend/.cache/
node_modules/
dist/

# ------------------------------------------
# Backend (Java + Spring Boot + Maven)
# ------------------------------------------
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
target/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
